# Azure Cosmos DB Configuration Template
# Copy this file to .env.cosmos and fill in your actual credentials
# NEVER commit .env.cosmos to git - it's already in .gitignore

# Your Cosmos DB endpoint URL
COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com:443/

# Your Cosmos DB primary or secondary key
COSMOS_DB_KEY=your-cosmos-db-key-here

# Alternative: Connection string (use either key or connection string, not both)
COSMOS_DB_CONNECTION_STRING=AccountEndpoint=https://your-account.documents.azure.com:443/;AccountKey=your-key-here;

# Database and container names
COSMOS_DB_DATABASE_NAME=genai-kb
COSMOS_DB_CONTAINER_NAME=documents

